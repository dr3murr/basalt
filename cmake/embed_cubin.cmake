# cmake -DIN=<file> -DOUT=<file.cpp> -DNAME=<symbol> -P embed_cubin.cmake: the bytes of IN as
# `extern const unsigned char NAME[]` and `extern const unsigned long long NAME_size` in OUT.
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" n)
math(EXPR bytes "${n} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" body "${body}")
file(WRITE "${OUT}.tmp"
  "// generated by cmake/embed_cubin.cmake from ${IN}\n"
  "extern const unsigned char ${NAME}[];\n"
  "extern const unsigned long long ${NAME}_size;\n"
  "alignas(16) const unsigned char ${NAME}[] = {\n${body}\n};\n"
  "const unsigned long long ${NAME}_size = ${bytes}ull;\n")
file(RENAME "${OUT}.tmp" "${OUT}")
